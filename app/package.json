{
  "name": "@simoona/app-foundation",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "bootstrap": "node ./scripts/foundation-check.mjs bootstrap",
    "lint": "node ./scripts/foundation-check.mjs lint",
    "typecheck": "node ./scripts/foundation-check.mjs typecheck",
    "test": "node ./scripts/foundation-check.mjs test",
    "smoke": "node ./scripts/foundation-check.mjs smoke",
    "smoke:integrations": "node ./infra/scripts/verify-integration-smoke.mjs",
    "smoke:integrations:strict": "node ./infra/scripts/verify-integration-smoke.mjs --strict",
    "smoke:integrations:staging": "node ./infra/scripts/verify-integration-smoke.mjs --env-file ./infra/contracts/integration-staging-credential-references.env",
    "smoke:integrations:strict:staging": "node ./infra/scripts/verify-integration-smoke.mjs --strict --env-file ./infra/contracts/integration-staging-credential-references.env",
    "migration:dry-run:001": "node ./infra/scripts/run-migration-dry-run.mjs --run-id 001 --report ./docs/orchestration/evidence/dry-run-001-integrity-report.md",
    "migration:dry-run:002": "node ./infra/scripts/run-migration-dry-run.mjs --run-id 002 --report ./docs/orchestration/evidence/dry-run-002-integrity-report.md",
    "migration:rollback:rehearsal": "node ./infra/scripts/run-migration-rollback-rehearsal.mjs --report ./docs/orchestration/evidence/rollback-rehearsal-001.md",
    "migration:gate6:precheck": "node ./infra/scripts/verify-gate6-readiness.mjs --strict",
    "build": "node ./scripts/foundation-check.mjs build",
    "ci:foundation": "bash ./infra/ci/run-foundation-ci.sh",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm smoke && pnpm build"
  }
}
