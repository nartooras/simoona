# Phase 5 integration credential references for staging smoke checks.
# These are secret references and non-secret integration values only.
# Do not put raw credentials in this file.

# OAuth / external auth
INTEGRATION_AUTH_CLIENT_ID=simoona-staging-client
INTEGRATION_AUTH_CLIENT_SECRET_REF=1password://simoona/staging/integrations/oauth/client-secret
INTEGRATION_AUTH_AUTHORITY_URL=https://auth.staging.simoona.local
INTEGRATION_AUTH_REDIRECT_URI=https://web.staging.simoona.local/auth/callback

# SMTP
INTEGRATION_SMTP_HOST=smtp.staging.simoona.local
INTEGRATION_SMTP_PORT=587
INTEGRATION_SMTP_USER=notifications@simoona.local
INTEGRATION_SMTP_PASSWORD_REF=1password://simoona/staging/integrations/smtp/password
INTEGRATION_SMTP_FROM=notifications@simoona.local

# Storage / media
INTEGRATION_STORAGE_PROVIDER=s3-compatible
INTEGRATION_STORAGE_BUCKET=simoona-staging-media
INTEGRATION_STORAGE_BASE_URL=https://storage.staging.simoona.local
INTEGRATION_STORAGE_ACCESS_KEY_REF=1password://simoona/staging/integrations/storage/access-key
INTEGRATION_STORAGE_SECRET_KEY_REF=1password://simoona/staging/integrations/storage/secret-key

# External jobs callbacks
INTEGRATION_EXTERNAL_JOBS_BASE_URL=https://jobs.staging.simoona.local/api
INTEGRATION_EXTERNAL_JOBS_TOKEN_REF=1password://simoona/staging/integrations/external-jobs/token
