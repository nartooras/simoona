{
  "name": "@simoona/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node --experimental-strip-types ./scripts/live-web-runtime.mjs dev",
    "preview": "node --experimental-strip-types ./scripts/live-web-runtime.mjs preview",
    "runtime:build": "node --experimental-strip-types ./scripts/live-web-runtime.mjs build",
    "syntax:check": "node ./scripts/verify-web-syntax.mjs",
    "shell:check:foundation": "node ./scripts/verify-web-shell-foundation.mjs",
    "shell:check:routes": "node ./scripts/verify-shell-route-pack.mjs",
    "shell:check": "pnpm shell:check:foundation && pnpm shell:check:routes",
    "lint": "pnpm syntax:check && pnpm shell:check",
    "typecheck": "pnpm syntax:check && pnpm shell:check",
    "test": "pnpm syntax:check && pnpm shell:check",
    "build": "pnpm syntax:check && pnpm shell:check && pnpm runtime:build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "typescript": "5.6.3",
    "vite": "5.4.2"
  }
}
