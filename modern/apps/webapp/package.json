{
    "name": "@simoona/webapp",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test": "vitest run",
        "test:smoke": "vitest run src/smoke/AppRoutes.smoke.test.tsx",
        "test:smoke:ci": "vitest run --reporter=dot src/smoke/AppRoutes.smoke.test.tsx",
        "lint": "eslint \"src/**/*.{ts,tsx}\" \"vite.config.ts\"",
        "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.vitest.json --noEmit"
    },
    "dependencies": {
        "i18next": "^25.4.2",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-i18next": "^16.0.1",
        "react-router-dom": "^7.8.2"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^19.1.13",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.0.2",
        "jsdom": "^27.0.0",
        "vite": "^7.1.3",
        "vitest": "^3.2.4"
    }
}
